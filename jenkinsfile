pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: ''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'sudo docker build -t myflaskimage:latest .'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    sudo docker stop flaskapp || true
                    sudo docker rm flaskapp || true
                    sudo docker run -d --name flaskapp -p 5000:5000 myflaskimage:latest
                '''
            }
        }
    }
}
